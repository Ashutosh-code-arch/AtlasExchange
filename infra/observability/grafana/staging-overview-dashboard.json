{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud Metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "Private metrics target",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "color": "red", "text": "Down" },
                "1": { "color": "green", "text": "Up" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "min(up{environment=\"staging\",job=\"atlas-api\"})",
          "instant": true,
          "legendFormat": "API metrics target",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Market Data projection",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "color": "red", "text": "Stopped" },
                "1": { "color": "green", "text": "Running" }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "atlas_market_data_projection_running{environment=\"staging\"}",
          "instant": true,
          "legendFormat": "Projection",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "API request rate by status class",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (status_class) (rate(atlas_http_requests_total{environment=\"staging\"}[5m]))",
          "legendFormat": "{{status_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "API p95 latency by route group",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,route_group) (rate(atlas_http_request_duration_seconds_bucket{environment=\"staging\"}[5m])))",
          "legendFormat": "p95 {{route_group}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "PostgreSQL pool pressure",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "atlas_database_pool_connections{environment=\"staging\"}",
          "legendFormat": "connections {{state}}",
          "refId": "A"
        },
        {
          "expr": "atlas_database_pool_waiting_requests{environment=\"staging\"}",
          "legendFormat": "waiting",
          "refId": "B"
        },
        {
          "expr": "atlas_database_pool_max_connections{environment=\"staging\"}",
          "legendFormat": "configured maximum",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "title": "Node.js event-loop delay",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "atlas_nodejs_event_loop_delay_p99_seconds{environment=\"staging\"}",
          "legendFormat": "p99 delay",
          "refId": "A"
        },
        {
          "expr": "atlas_nodejs_event_loop_delay_max_seconds{environment=\"staging\"}",
          "legendFormat": "max delay",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "Market Data projection pressure",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "atlas_market_data_projection_max_lag{environment=\"staging\"}",
          "legendFormat": "max sequence lag",
          "refId": "A"
        },
        {
          "expr": "atlas_market_data_projection_max_consecutive_failures{environment=\"staging\"}",
          "legendFormat": "max consecutive failures",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Admission rejection rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (request_class,reason) (rate(atlas_http_admission_rejections_total{environment=\"staging\"}[5m]))",
          "legendFormat": "{{request_class}} / {{reason}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["atlas", "staging", "operations"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "utc",
  "title": "Atlas staging operations",
  "uid": "atlas-staging-operations",
  "version": 1
}
