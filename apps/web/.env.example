# Public API URL served by Vite during local development and tests. Never place secrets here.
VITE_API_BASE_URL=http://localhost:3000

# Public API URL served to the browser at production runtime. Never place secrets here.
ATLAS_WEB_API_BASE_URL=https://api.example.com

# The production web server requires these values when ATLAS_ENV=staging.
ATLAS_ENV=local
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUDIENCE=replace-with-the-access-application-audience

# Production static-server port. Deployment may alternatively provide PORT.
ATLAS_WEB_PORT=8080
