# HTTP port exposed by the API.
# Managed runtimes may inject PORT, which takes precedence over API_PORT.
API_PORT=3000

# Browser origin allowed to call the API.
WEB_ORIGIN=http://localhost:5173

# Required in staging. Both concrete web/API hosts belong to this Cloudflare Access application.
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUDIENCE=replace-with-the-access-application-audience

# Exact number of private ingress proxy hops trusted for client identity. Managed environments
# require at least one; keep zero when the API is reached directly during local development.
HTTP_TRUST_PROXY_HOPS=0

# Direct-connection resource limits. Forwarded client identity remains untrusted until deployment.
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_HEADERS_COUNT=100
HTTP_MAX_REQUESTS_PER_SOCKET=1000

# Coarse API admission budgets per direct network peer. Module-specific limits remain independent.
HTTP_RATE_LIMIT_WINDOW_MS=60000
HTTP_READ_RATE_LIMIT_MAX_REQUESTS=600
HTTP_MUTATION_RATE_LIMIT_MAX_REQUESTS=120
HTTP_RATE_LIMIT_MAX_TRACKED_CLIENTS=10000

# Local PostgreSQL connection string. Required.
DATABASE_URL=postgresql://atlas:atlas_local_only@localhost:5432/atlas

# Per-API-process PostgreSQL capacity and execution limits. Size the aggregate across replicas.
DATABASE_POOL_MAX_CONNECTIONS=10
DATABASE_POOL_CONNECTION_TIMEOUT_MS=2000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_MAX_LIFETIME_SECONDS=300
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
DATABASE_READINESS_TIMEOUT_MS=1000

# Runtime and deployment identities. Accepted Atlas environments are local, test, ci, demo,
# staging, and production. Demo is a managed, Access-protected simulation environment.
NODE_ENV=development
ATLAS_ENV=local
ATLAS_APPLICATION_VERSION=0.1.1

# Structured log threshold.
LOG_LEVEL=debug

# Prometheus-compatible internal scrape endpoint. Keep disabled until a protected scraper is wired.
METRICS_ENABLED=false
# Dedicated bearer secret with 32-256 characters. Required when metrics are enabled.
# METRICS_BEARER_TOKEN=replace-with-a-dedicated-monitoring-secret

# Expected committed database schema version.
EXPECTED_SCHEMA_VERSION=15

# Market Data projection worker. Lag is observable but does not change command API readiness.
MARKET_DATA_PROJECTION_ENABLED=true
MARKET_DATA_PROJECTION_POLL_INTERVAL_MS=250
MARKET_DATA_PROJECTION_BATCH_SIZE=250
MARKET_DATA_PROJECTION_MAX_BATCHES_PER_CYCLE=8
MARKET_DATA_PROJECTION_RETRY_INITIAL_DELAY_MS=500
MARKET_DATA_PROJECTION_RETRY_MAXIMUM_DELAY_MS=30000

# Public Market Data WebSocket stream. Full replaceable snapshots make reconnect recovery explicit.
MARKET_DATA_STREAM_ENABLED=true
MARKET_DATA_STREAM_REFRESH_INTERVAL_MS=1000
MARKET_DATA_STREAM_HEARTBEAT_INTERVAL_MS=15000
MARKET_DATA_STREAM_MAX_CONNECTIONS=1000
MARKET_DATA_STREAM_MAX_CONNECTIONS_PER_CLIENT=5
MARKET_DATA_STREAM_MAX_SUBSCRIPTIONS_PER_CONNECTION=12
MARKET_DATA_STREAM_MAX_MESSAGE_BYTES=8192
MARKET_DATA_STREAM_MAX_BUFFERED_BYTES=1048576

# Read-only external reference prices. This feed never affects Atlas matching or settlement.
REFERENCE_MARKET_DATA_ENABLED=false
REFERENCE_MARKET_DATA_WEBSOCKET_URL=wss://advanced-trade-ws.coinbase.com
REFERENCE_MARKET_DATA_STALE_AFTER_MS=15000
REFERENCE_MARKET_DATA_HEARTBEAT_TIMEOUT_MS=10000
REFERENCE_MARKET_DATA_RECONNECT_INITIAL_DELAY_MS=1000
REFERENCE_MARKET_DATA_RECONNECT_MAXIMUM_DELAY_MS=30000

# Simulated balances only. Defaults off in staging/production when omitted.
SIMULATED_FUNDING_ENABLED=true
SIMULATED_WITHDRAWALS_ENABLED=true

# Required explicitly in staging/production. The file contains one SHA-256 digest per line.
# It is also required in demo, where the operator bootstrap validates the prepared password.
# Local/test uses resources/development-password-blocklist.sha256 when omitted.
# PASSWORD_BLOCKLIST_PATH=/run/secrets/atlas-password-blocklist.sha256

# SMTP delivery. Local defaults target Mailpit from the host API process.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Atlas Exchange <no-reply@atlas.local>
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Base64url-encoded key with at least 256 bits. Required explicitly in staging/production.
# It is also required in demo.
# Local/test uses a repository-known development key when omitted.
# CSRF_HMAC_KEY=

# Maximum graceful-shutdown wait in milliseconds.
SHUTDOWN_TIMEOUT_MS=10000

# Demo identity provisioning is intentionally not configured in this repository file. The
# operator command requires ATLAS_DEMO_BOOTSTRAP_ENV_FILE to name a mode-0600 file outside the
# repository containing DEMO_IDENTITY_EMAIL and DEMO_IDENTITY_PASSWORD.
