# HTTP port exposed by the API.
API_PORT=3000

# Browser origin allowed to call the API.
WEB_ORIGIN=http://localhost:5173

# Local PostgreSQL connection string. Required.
DATABASE_URL=postgresql://atlas:atlas_local_only@localhost:5432/atlas

# Runtime and deployment identities.
NODE_ENV=development
ATLAS_ENV=local

# Structured log threshold.
LOG_LEVEL=debug

# Expected committed database schema version.
EXPECTED_SCHEMA_VERSION=6

# Required explicitly in staging/production. The file contains one SHA-256 digest per line.
# Local/test uses resources/development-password-blocklist.sha256 when omitted.
# PASSWORD_BLOCKLIST_PATH=/run/secrets/atlas-password-blocklist.sha256

# SMTP delivery. Local defaults target Mailpit from the host API process.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Atlas Exchange <no-reply@atlas.local>
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Base64url-encoded key with at least 256 bits. Required explicitly in staging/production.
# Local/test uses a repository-known development key when omitted.
# CSRF_HMAC_KEY=

# Maximum graceful-shutdown wait in milliseconds.
SHUTDOWN_TIMEOUT_MS=10000
