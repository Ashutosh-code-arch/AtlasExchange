# HTTP port exposed by the API.
API_PORT=3000

# Browser origin allowed to call the API.
WEB_ORIGIN=http://localhost:5173

# Local PostgreSQL connection string. Required.
DATABASE_URL=postgresql://atlas:atlas_local_only@localhost:5432/atlas

# Runtime and deployment identities.
NODE_ENV=development
ATLAS_ENV=local

# Structured log threshold.
LOG_LEVEL=debug

# Expected committed database schema version.
EXPECTED_SCHEMA_VERSION=1

# Maximum graceful-shutdown wait in milliseconds.
SHUTDOWN_TIMEOUT_MS=10000
