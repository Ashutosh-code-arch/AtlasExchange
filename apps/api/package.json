{
  "name": "@atlas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "dev:once": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "prebuild": "pnpm --filter @atlas/contracts build",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm --filter @atlas/contracts build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @atlas/contracts build",
    "test": "vitest run",
    "lint": "eslint src tests --max-warnings 0",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/platform/database/migrate.ts"
  },
  "dependencies": {
    "@atlas/contracts": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  }
}
