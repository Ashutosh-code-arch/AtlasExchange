{
  "name": "@atlas/gateway",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "pnpm --filter @atlas/web build && wrangler deploy",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests vitest.config.ts --max-warnings 0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260830.1",
    "vitest": "^4.1.11",
    "wrangler": "4.127.1"
  }
}
